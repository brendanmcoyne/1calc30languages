{
    "java.project.sourcePaths": [
        "java"
    ],
    "java.project.referencedLibraries": [
        "lib/**/*.jar"
    ],
    "code-runner.executorMap": {
        "c": "cd $dir && gcc $fileName -o $fileNameWithoutExt -lm && ./$fileNameWithoutExt",
        "csharp": "cd \"$dir\" && dotnet run",
        "typescript": "cd \"$dir\" && ./node_modules/.bin/ts-node \"$fileName\"",
        "kotlin": "cd \"$dir\" && /home/brendanmcoyne/.sdkman/candidates/kotlin/current/bin/kotlinc \"$fileName\" -include-runtime -d \"$fileNameWithoutExt.jar\" && java -jar \"$fileNameWithoutExt.jar\"",
        "swift": "cd \"$dir\" && /home/brendanmcoyne/.local/share/swiftly/bin/swift \"$fileName\"",
        "rust": "cd \"$dir\" && rustc \"$fileName\" -o \"$fileNameWithoutExt\" && ./\"$fileNameWithoutExt\"; rm -f \"$fileNameWithoutExt\""
    },
    "files.exclude": {
    "**/bin": true,
    "**/obj": true
    },
    
    "code-runner.runInTerminal": false,
    "code-runner.saveFileBeforeRun": true,
    "editor.occurrencesHighlight": "off",
    "editor.selectionHighlight": false,
    
}